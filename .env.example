# Опциональные ключи внешних LLM и STT (проект полностью автономен и работает БЕЗ них на встроенном NLU-парсере и Web Speech)
GROQ_API_KEY=""        # Для LLM qwen/qwen3.8-27b и сверхбыстрого STT Whisper-large-v3-turbo
MISTRAL_API_KEY=""     # Резервная LLM Mistral
YANDEX_API_KEY=""      # Опционально: резервный Yandex SpeechKit STT
YANDEX_FOLDER_ID=""    # Опционально: каталог Yandex Cloud
OPENAI_API_KEY=""      # Опционально: резервный OpenAI Whisper
TELEGRAM_BOT_TOKEN=""  # Токен Telegram бота от @BotFather
PORT=8000              # Внешний порт приложения

